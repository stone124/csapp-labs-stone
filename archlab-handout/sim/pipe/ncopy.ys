#/* $begin ncopy-ys */
##################################################################
# ncopy.ys - Copy a src block of len words to dst.
# Return the number of positive words (>0) contained in src.
#
# Include your name and ID here.
# name: stone
#
# Describe how and why you modified the baseline code.
#
##################################################################
# Do not modify this portion
# Function prologue.
# %rdi = src, %rsi = dst, %rdx = len
ncopy:

##################################################################
# You can modify this portion
	# Loop header
	xorq %rax,%rax		# count = 0;
	irmovq $1, %r9 # 常数1, %r9
	irmovq $2, %rcx # 常数2, %rcx
	irmovq $16, %r11 # 常数地址挪2，也就是16字节
	rrmovq %rdx, %r8
	subq %r9, %r8		# len > 1?
	jg Loop		# if so, goto Loop:
	jmp Remain # if not, remain

Loop:
	mrmovq (%rdi), %r10	# read val from src...
	mrmovq 8(%rdi), %r8
	addq %r11, %rdi		# src+2
	addq %r11, %rsi		# dst+2
	rmmovq %r10, -16(%rsi)	# ...and store it to dst 这里和上一条指令形成了依赖，必须等上条走完memory阶段，这一条才能走decode，可以提前进行位置加减
	rmmovq %r8, -8(%rsi)
	andq %r10, %r10		# val1 <= 0?
	jle Val
	addq %r9, %rax
Val:
	andq %r8, %r8  # val2 <= 0
	jle Npos		# if so, goto Npos:
	addq %r9, %rax		# count++
Npos:	
	subq %rcx, %rdx		# len-2
	rrmovq %rdx, %r8
	subq %r9, %r8		# len > 1?
	jg Loop			# if so, goto Loop:
Remain:
	andq %rdx, %rdx # len <= 0
	jle Done
	mrmovq (%rdi), %r10 # src[0]读出val
	rmmovq %r10, (%rsi) # 放到dst里面
	
	andq %r10, %r10
	jle Done # val <=0, jump done
	addq %r9, %rax


##################################################################
# Do not modify the following section of code
# Function epilogue.
Done:
	ret
##################################################################
# Keep the following label at the end of your function
End:
#/* $end ncopy-ys */
