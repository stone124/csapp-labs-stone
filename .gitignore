
# ==========================================
# CSAPP Labs - .gitignore
# ==========================================

# C/C++ 编译中间产物
*.o
*.obj
*.a
*.so
*.so.*
*.dll
*.dylib
*.exe
*.out
*.d
*.gcda
*.gcno
*.gcov

# CMake 构建产物
build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
compile_commands.json

# Data Lab 编译产物
btest
fshow
ishow

# 其他实验编译产物
csim
test-csim
test-trans
mdriver
sdriver
tsh
myspin
mysplit
mystop
myint
/proxylab/tiny/tiny
proxy

# 调试与临时文件
core
core.*
*.log
*.tmp
*.swp
*.swo
*~
.gdb_history

# 编辑器与系统文件
.vscode/
.idea/
.DS_Store
Thumbs.db

# Python 缓存
__pycache__/
*.pyc
.venv/

# Arch Lab：保留源码，忽略构建产物和自动生成的测试文件
/archlab-handout/sim/**/*.yo
/archlab-handout/sim/**/*.yis
/archlab-handout/sim/**/*.pipe
/archlab-handout/sim/**/*.seq
/archlab-handout/sim/**/*.seq+

# 汇编器、模拟器和 HCL 工具
/archlab-handout/sim/misc/yas
/archlab-handout/sim/misc/yis
/archlab-handout/sim/misc/hcl2c
/archlab-handout/sim/misc/hcl2v
/archlab-handout/sim/misc/hcl2u
/archlab-handout/sim/misc/mux4
/archlab-handout/sim/seq/ssim
/archlab-handout/sim/seq/ssim+
/archlab-handout/sim/pipe/psim

# flex、bison 和 HCL 自动生成的 C 源码
/archlab-handout/sim/misc/yas-grammar.c
/archlab-handout/sim/misc/lex.yy.c
/archlab-handout/sim/misc/hcl.tab.c
/archlab-handout/sim/misc/hcl.tab.h
/archlab-handout/sim/seq/seq*-*.c
/archlab-handout/sim/pipe/pipe-*.c

# 自动生成的测试程序（保留 misc/*.ys、pipe/ncopy.ys 和 y86-code/*.ys）
/archlab-handout/sim/ptest/*.ys
/archlab-handout/sim/pipe/sdriver.ys
/archlab-handout/sim/pipe/ldriver.ys
/archlab-handout/sim/pipe/driver*.ys

# Cache Lab：保留原始测试工具，忽略本地构建与测试产物
!/cachelab/test-csim
/cachelab/tracegen
/cachelab/*-handin.tar
/cachelab/.csim_results
/cachelab/.marker
/cachelab/trace.all
/cachelab/trace.f*

# Shell Lab：保留参考程序与参考输出，忽略本地运行产物
!/shelllab/tshref.out
